# Intervalo de muestreo en minutos. Minimo seguro recomendado: 5.
POLL_INTERVAL_MIN=15

# Conexion a PostgreSQL (host "db" es el nombre del servicio en docker-compose)
DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/findhub

# Ruta (dentro del contenedor backend) al archivo auth/secrets.json generado por auth
AUTH_SECRETS_PATH=/app/auth/secrets.json

# Token bearer opcional para la API (vacio = sin autenticacion)
# API_TOKEN=

# Logging
LOG_LEVEL=INFO